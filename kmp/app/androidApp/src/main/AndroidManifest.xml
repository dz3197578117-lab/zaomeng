<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Android 11（API 30）起有「包可见性」限制：不声明这一条，App **枚举不到任何 TTS 引擎**，
        TextToSpeech 初始化直接回调 ERROR，表现为「点朗读完全没声音、也没有任何报错」
        ——因为初始化回调只处理 SUCCESS，会把待播内容一直挂着。
        Android 官方文档要求 targetSdk 30+ 且使用 TTS 的 App 声明这个 intent。
        本项目的 targetSdk 是 36，所以这条是**必需**的。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ZaomengApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="33"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/zaomeng_logo"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:roundIcon="@drawable/zaomeng_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!--
            为什么由 Activity 自己处理这些配置变更：
            导航返回栈是 `remember` 出来的（见 navigation/ZaomengNavHost.kt:120），
            而 MainActivity 一旦被「销毁—重建」，整个栈就回到书卷架，
            对话里正在流式生成的那一轮、章节页与写作助手弹层里的页面级 ViewModel 一起蒸发。
            实测表现就是「转个屏就回到首页」。
            这些配置项 Compose 都能在重组时自己接住（主题由偏好驱动、
            Density 来自 LocalDensity、文案方向来自 layoutDirection），不需要重建 Activity。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|layoutDirection|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="top.wkbin.zaomeng.backend.DistillationForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <service
            android:name="top.wkbin.zaomeng.backend.NovelConversionForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
